---
import type { GetStaticPaths } from 'astro';
import { getImage } from 'astro:assets';
import Sections from '../../components/Sections.astro';
import Base from '../../layouts/Base.astro';
import { imageFor } from '../../data/images.ts';
import { getProducts, getProductsByHandle, getShopCollections } from '../../data/queries.ts';
import type { Product } from '../../lib/catalog.ts';
import { productJsonLd } from '../../lib/commerce.ts';
import { productThemePage } from '../../lib/site-content.ts';
import { siteConfig } from '../../site.config.ts';

export const getStaticPaths = (async () => {
  const products = await getProducts();
  return products.map((product) => ({ params: { handle: product.handle }, props: { product } }));
}) satisfies GetStaticPaths;

interface Props {
  product: Product;
}

const { product } = Astro.props;
// The product template (product.product-catalogue.json) with this product as `closest.product`.
const model = productThemePage(product.handle);

// Stands in for Shopify's recommendations (an allowed difference): other products of the same collection.
const collection = (await getShopCollections()).find((c) => c.url === product.collection?.url);
const related = collection
  ? (await getProductsByHandle(collection.productHandles.filter((h) => h !== product.handle))).slice(0, 4)
  : [];

const jsonImages = await Promise.all(
  product.images.map(async (image) => {
    const meta = await imageFor(image.file);
    const result = await getImage({ src: meta, width: Math.min(1200, meta.width), format: 'webp', quality: 78 });
    return new URL(result.src, siteConfig.siteUrl).href;
  }),
);
const jsonLd = productJsonLd({
  name: product.title,
  description: product.seo.description,
  url: new URL(product.url, siteConfig.siteUrl).href,
  images: jsonImages,
  sku: product.sku,
  category: product.productType,
  brand: product.vendor || 'Rosart',
});
---

<Base title={product.seo.title} description={product.seo.description} ogImage={product.images[0]} ogType="product" jsonLd={jsonLd}>
  <Sections sections={model.sections} related={related} />
</Base>
