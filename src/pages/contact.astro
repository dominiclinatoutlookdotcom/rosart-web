---
import Sections from '../components/Sections.astro';
import Base from '../layouts/Base.astro';
import { getPage, getThemePage } from '../data/queries.ts';

const page = await getPage('contact');
const model = await getThemePage('contact');
---

<Base title={page.seo.title} description={page.seo.description}>
  <Sections sections={model.sections} />
</Base>
