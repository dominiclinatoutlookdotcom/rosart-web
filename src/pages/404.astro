---
import Sections from '../components/Sections.astro';
import Base from '../layouts/Base.astro';
import { getFeaturedProducts, getThemePage } from '../data/queries.ts';
import { htmlToText } from '../lib/html.ts';

const model = await getThemePage('not-found');
const products = await getFeaturedProducts(4);
const first = model.sections[0];
const heading = first && 'blocks' in first ? first.blocks.find((b) => b.kind === 'heading') : undefined;
const body = first && 'blocks' in first ? first.blocks.find((b) => b.kind === 'richtext') : undefined;
---

<Base
  title={heading?.kind === 'heading' ? heading.text : 'Page not found'}
  description={body?.kind === 'richtext' ? htmlToText(body.html) : 'Page not found'}
  notFound
>
  <Sections sections={model.sections} products={products} />
</Base>
