---
import Sections from '../components/Sections.astro';
import Base from '../layouts/Base.astro';
import { getProducts, getThemePage } from '../data/queries.ts';
import { htmlToText } from '../lib/html.ts';

const model = await getThemePage('not-found');
const products = await getProducts();
const first = model.sections[0];
const blocks = first?.kind === 'content' ? first.blocks : [];
const heading = blocks.find((b) => b.kind === 'heading');
const body = blocks.find((b) => b.kind === 'richtext');
---

<Base
  title={heading?.kind === 'heading' ? heading.text : 'Page not found'}
  description={body?.kind === 'richtext' ? htmlToText(body.html) : 'Page not found'}
  notFound
>
  <Sections sections={model.sections} products={products} />
</Base>
