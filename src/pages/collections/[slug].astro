---
import type { GetStaticPaths } from 'astro';
import Sections from '../../components/Sections.astro';
import Base from '../../layouts/Base.astro';
import { getProducts, getShopCollections } from '../../data/queries.ts';
import type { Collection } from '../../lib/catalog.ts';
import { collectionThemePage } from '../../lib/site-content.ts';

export const getStaticPaths = (async () => {
  const collections = await getShopCollections();
  return collections.map((collection) => ({ params: { slug: collection.slug }, props: { collection } }));
}) satisfies GetStaticPaths;

interface Props {
  collection: Collection;
}

const { collection } = Astro.props;
const model = collectionThemePage(collection.handle);
const products = await getProducts();
---

<Base title={collection.seo.title} description={collection.seo.description} ogImage={collection.image}>
  <Sections sections={model.sections} products={products} />
</Base>
