---
import Sections from '../components/Sections.astro';
import Base from '../layouts/Base.astro';
import { getPage, getThemePage } from '../data/queries.ts';
import { describeSections } from '../lib/theme.ts';

const page = await getPage('our-story');
const story = await getThemePage('our-story');
const hasH1 = story.sections.some((s) => s.kind === 'page-title' && s.showTitle);
const hero = story.sections.find((s) => s.kind === 'hero');
---

<Base
  title={page.seo.title}
  description={page.seo.description || describeSections(story.sections)}
  ogImage={hero?.kind === 'hero' ? hero.image : null}
>
  {!hasH1 && <h1 class="sr-only">{page.title}</h1>}
  <Sections sections={story.sections} page={page} />
</Base>
