---
import Sections from '../components/Sections.astro';
import Base from '../layouts/Base.astro';
import { getPage, getThemePage } from '../data/queries.ts';
import { describeSections, hasH1 } from '../lib/theme.ts';

const page = await getPage('our-story');
const story = await getThemePage('our-story');
const hero = story.sections.find((s) => s.kind === 'hero');
---

<Base
  title={page.seo.title}
  description={page.seo.description || describeSections(story.sections)}
  ogImage={hero?.kind === 'hero' ? hero.image : null}
>
  {!hasH1(story.sections) && <h1 class="sr-only" data-allowed="screen-reader-h1">{page.title}</h1>}
  <Sections sections={story.sections} />
</Base>
