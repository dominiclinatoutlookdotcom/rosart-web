---
import type { Product } from '../lib/catalog.ts';
import type { CardTemplate } from '../lib/theme.ts';
import ProductCard from './ProductCard.astro';

interface Props {
  products: Product[];
  /** The theme's card template; absent for the related products. */
  card?: CardTemplate | null;
  headingLevel?: 2 | 3;
}

const { products, card = null, headingLevel = 3 } = Astro.props;
---

<ul class="product-grid" role="list">
  {
    products.map((product) => (
      <li>
        <ProductCard product={product} card={card} headingLevel={headingLevel} />
      </li>
    ))
  }
</ul>
