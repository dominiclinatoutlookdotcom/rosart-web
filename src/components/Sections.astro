---
/**
 * Renders a page's theme sections in the theme's order, each with its theme id and type
 * (`data-theme-section`, `data-theme-type`) for the fidelity check. Layout follows the content: a
 * section with an image beside a text group is a split, several image groups are tiles, a
 * background image makes a band, anything else is a centred text block.
 */
import type { Product } from '../lib/catalog.ts';
import type { Block, Section } from '../lib/theme.ts';
import Blocks from './Blocks.astro';
import HeroPicture from './HeroPicture.astro';
import Img from './Img.astro';
import ProductGrid from './ProductGrid.astro';

interface Props {
  sections: Section[];
  /** Every product, for the lists the theme names (they pick theirs by handle). */
  products?: Product[];
  /** The related products that stand in for Shopify's recommendations (an allowed difference). */
  related?: Product[];
}

const { sections, products = [], related = [] } = Astro.props;
const byHandle = new Map(products.map((p) => [p.handle, p]));
const pick = (handles: readonly string[]) => handles.flatMap((h) => byHandle.get(h) ?? []);

function layout(blocks: readonly Block[]): 'split' | 'tiles' | 'stack' {
  const groups = blocks.filter((b) => b.kind === 'group');
  if (groups.length >= 2 && groups.length === blocks.length) return 'tiles';
  if (blocks.length === 2 && blocks.some((b) => b.kind === 'image') && blocks.some((b) => b.kind === 'group')) return 'split';
  return 'stack';
}
const onlyImages = (blocks: readonly Block[]) => blocks.every((b) => b.kind === 'image');
const firstHero = sections.findIndex((s) => s.kind === 'hero');
const isFirstSectionH1 = (blocks: readonly Block[]) => blocks.some((b) => b.kind === 'heading' && b.level === 1);
---

{
  sections.map((section, index) => {
    const theme = { id: section.id, 'data-theme-section': section.id, 'data-theme-type': section.type };
    switch (section.kind) {
      case 'hero':
        return (
          <section class:list={['hero', section.blocks.length > 0 && 'hero-with-text']} {...theme}>
            {section.image && (
              <HeroPicture class="hero-picture" image={section.image} mobileImage={section.mobileImage} priority={index === firstHero && index === 0} />
            )}
            {section.blocks.length > 0 && (
              <div class="hero-text">
                <Blocks blocks={section.blocks} />
              </div>
            )}
          </section>
        );
      case 'content': {
        const kind = layout(section.blocks);
        return (
          <section
            class:list={[
              'content-section',
              `layout-${kind}`,
              section.type === 'main-page' && isFirstSectionH1(section.blocks) && 'page-heading',
              section.background ? 'has-background' : kind === 'stack' && !onlyImages(section.blocks) && 'tone-blush',
            ]}
            {...theme}
          >
            {section.background && (
              <Img class="section-background" image={section.background} alt="" widths={[750, 1200, 1920]} sizes="100vw" priority={index === 0} />
            )}
            <div class="section-inner">
              <Blocks
                blocks={section.blocks}
                imageSizes={kind === 'tiles' ? '(min-width: 900px) 33vw, 100vw' : kind === 'split' ? '(min-width: 900px) 50vw, 100vw' : '(min-width: 1100px) 1000px, 100vw'}
              />
            </div>
          </section>
        );
      }
      case 'spacer':
        return <div class="theme-spacer" aria-hidden="true" {...theme} />;
      case 'collection-list':
        return (
          <section class="content-section collection-list" {...theme}>
            <div class="section-inner">
              <Blocks blocks={section.before} />
              <ul class="collection-cards" role="list">
                {section.card &&
                  section.collections.map((collection) => (
                    <li>
                      <a class="tile" href={collection.url} data-theme-block={section.card?.id} data-theme-type={section.card?.type}>
                        {section.card?.blocks.map((block) =>
                          block.type === '_collection-card-image' ? (
                            <div class="tile-media" data-theme-block={block.id} data-theme-type={block.type}>
                              {collection.image && <Img image={collection.image} alt="" widths={[400, 600, 800]} sizes="(min-width: 900px) 33vw, 100vw" />}
                            </div>
                          ) : block.type === 'collection-title' ? (
                            <h3 data-theme-block={block.id} data-theme-type={block.type}>
                              {collection.title}
                            </h3>
                          ) : null,
                        )}
                      </a>
                    </li>
                  ))}
              </ul>
              <Blocks blocks={section.after} />
            </div>
          </section>
        );
      case 'product-list':
        return (
          <section class="content-section products-section" {...theme}>
            <div class="section-inner">
              <Blocks blocks={section.before} />
              {section.card && <ProductGrid products={pick(section.productHandles)} card={section.card} />}
              <Blocks blocks={section.after} />
            </div>
          </section>
        );
      case 'product':
        return (
          <section class="product-page" {...theme}>
            <div class="product-layout">
              <Blocks blocks={section.blocks} />
            </div>
          </section>
        );
      case 'recommendations':
        return (
          <section class="content-section products-section" {...theme}>
            <div class="section-inner">
              <Blocks blocks={section.blocks} />
              {related.length > 0 && (
                <div data-allowed="related-products">
                  <ProductGrid products={related} />
                </div>
              )}
            </div>
          </section>
        );
      case 'connections':
        return (
          <section class="content-section connections" aria-labelledby={`${section.id}-heading`} {...theme}>
            <div class="section-inner">
              <h2 id={`${section.id}-heading`}>{section.heading}</h2>
              {section.intro && <p class="intro">{section.intro}</p>}
              <ul class="connection-list" role="list">
                {section.items.map((item) => (
                  <li class="connection">
                    <p class="eyebrow">{item.role}</p>
                    <Img class="connection-logo" image={item.logo} widths={[300, 600]} sizes="285px" />
                    <h3>{item.name}</h3>
                    {item.link && (
                      <a href={item.link.href} rel="noopener noreferrer" class="text-link">
                        {item.link.label}
                        <span class="sr-only" data-allowed="external-link-note">
                          {' '}
                          ({item.name}, external site)
                        </span>
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          </section>
        );
    }
  })
}
