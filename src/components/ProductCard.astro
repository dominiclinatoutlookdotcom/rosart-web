---
import { siteConfig } from '../site.config.ts';
import type { Product } from '../lib/catalog.ts';
import { formatPrice } from '../lib/commerce.ts';
import Img from './Img.astro';

interface Props {
  product: Product;
  headingLevel?: 2 | 3;
}

const { product, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const image = product.images[0];
---

<article class="product-card">
  <a href={product.url} class="product-card-link">
    {
      image && (
        <Img
          class="product-card-image"
          image={image}
          alt=""
          widths={[320, 480, 640]}
          sizes="(min-width: 1100px) 260px, (min-width: 700px) 30vw, 50vw"
        />
      )
    }
    <Heading class="product-card-title">{product.title}</Heading>
  </a>
  {siteConfig.showPrices && <p class="price">{formatPrice(product.price)}</p>}
</article>
