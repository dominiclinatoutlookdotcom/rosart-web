---
/**
 * One product card. With the theme's card template it renders the template's blocks in order
 * (image, title, price) with their theme ids; without one (the related products that stand in for
 * Shopify's recommendations) it renders image and title plainly.
 */
import { siteConfig } from '../site.config.ts';
import type { Product } from '../lib/catalog.ts';
import { formatPrice } from '../lib/commerce.ts';
import type { CardTemplate, ThemeSource } from '../lib/theme.ts';
import Img from './Img.astro';

interface Props {
  product: Product;
  card?: CardTemplate | null;
  headingLevel?: 2 | 3;
}

const { product, card = null, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const image = product.images[0];
const fallback: ThemeSource[] = [
  { id: '', type: '_product-card-gallery' },
  { id: '', type: 'product-title' },
  ...(siteConfig.showPrices ? [{ id: '', type: 'price' }] : []),
];
const blocks = card ? card.blocks : fallback;
const theme = (source: ThemeSource) => (source.id ? { 'data-theme-block': source.id, 'data-theme-type': source.type } : {});
---

<article class="product-card" {...(card ? theme(card) : {})}>
  <a href={product.url} class="product-card-link">
    {
      blocks.map((block) => {
        switch (block.type) {
          case '_product-card-gallery':
            return (
              <div class="product-card-media" {...theme(block)}>
                {image && (
                  <Img
                    class="product-card-image"
                    image={image}
                    alt=""
                    widths={[320, 480, 640]}
                    sizes="(min-width: 1100px) 260px, (min-width: 700px) 30vw, 50vw"
                  />
                )}
              </div>
            );
          case 'product-title':
            return (
              <Heading class="product-card-title" {...theme(block)}>
                {product.title}
              </Heading>
            );
          case 'price':
            return siteConfig.showPrices ? (
              <p class="price" {...theme(block)}>
                {formatPrice(product.price)}
              </p>
            ) : null;
          default:
            return null;
        }
      })
    }
  </a>
</article>
