---
/**
 * The theme's footer group in theme order: the footer text, then the utilities (copyright). Policy
 * links and the placeholder social links are allowed differences (see allowed-differences.ts).
 */
import type { ChromeSection } from '../lib/theme.ts';

interface Props {
  sections: ChromeSection[];
  shopName: string;
}

const { sections, shopName } = Astro.props;
const year = new Date().getFullYear();
const theme = (source: { id: string; type: string }, kind: 'section' | 'block') => ({
  [`data-theme-${kind}`]: source.id,
  'data-theme-type': source.type,
});
---

<footer class="site-footer">
  {
    sections.map((section) => (
      <div class:list={['footer-section', `footer-${section.type}`]} {...theme(section, 'section')}>
        {section.blocks.map((block) =>
          block.type === 'footer-copyright' ? (
            <p class="copyright" {...theme(block, 'block')}>
              &copy; {year}, {shopName}
            </p>
          ) : block.html ? (
            <div class="footer-text" set:html={block.html} {...theme(block, 'block')} />
          ) : null,
        )}
      </div>
    ))
  }
</footer>
