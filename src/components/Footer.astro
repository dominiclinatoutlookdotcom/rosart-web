---
import { siteConfig } from '../site.config.ts';
import type { ImageRef } from '../lib/images.ts';
import type { NavItem } from '../lib/theme.ts';
import Img from './Img.astro';

interface Props {
  footerText: string;
  logo: ImageRef | null;
  navigation: NavItem[];
  showCopyright: boolean;
}

const { footerText, logo, navigation, showCopyright } = Astro.props;
const links = navigation.flatMap((item) => [item, ...item.children]);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      {logo && <Img class="footer-logo" image={logo} alt="Rosart" widths={[160, 240, 320]} sizes="140px" />}
      {footerText && <p>{footerText}</p>}
      <p><a class="text-link" href={`mailto:${siteConfig.enquiryEmail}`}>{siteConfig.enquiryEmail}</a></p>
    </div>
    <nav aria-label="Footer">
      <ul class="footer-links" role="list">
        {
          links.map((item) => (
            <li>
              <a href={item.url}>{item.title}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  {showCopyright && <p class="copyright">&copy; {year} Rosart</p>}
</footer>
